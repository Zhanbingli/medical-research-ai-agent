# AI Provider API Keys (set at least one)
ANTHROPIC_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=

# Default AI provider: claude | kimi | qwen
DEFAULT_AI_PROVIDER=claude

# PubMed configuration (recommended to set your email for better rate limits)
PUBMED_EMAIL=your_email@example.com

# Cache settings
CACHE_DIR=./cache
CACHE_EXPIRY_DAYS=7

# Retry settings for AI calls
AI_PROVIDER_MAX_RETRIES=2
